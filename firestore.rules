rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidReview(data) {
      return data.keys().hasAll(['name', 'rating', 'comment', 'createdAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 60
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() >= 5 && data.comment.size() <= 1000
        && data.createdAt is string && data.createdAt.size() <= 50
        && (!('city' in data) || (data.city is string && data.city.size() <= 60))
        && (!('productName' in data) || (data.productName is string && data.productName.size() <= 100))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 400000))
        && (!('verifiedPurchase' in data) || data.verifiedPurchase is bool)
        && (!('avatarText' in data) || (data.avatarText is string && data.avatarText.size() <= 4));
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidId(reviewId) && isValidReview(request.resource.data);
      allow update, delete: if false;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
